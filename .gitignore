# ==========================================
# CIMS - Git Ignore
# ==========================================

# Node.js dependencies
node_modules/

# Environment variables / secrets
.env
.env.*
!.env.example

# Node / npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ==========================================
# Android / Gradle
# ==========================================

android/.gradle/
android/build/
android/app/build/
android/**/build/
android/local.properties
android/.cxx/

# Android generated APK/AAB files
*.apk
*.aab

# Capacitor generated web assets
android/app/src/main/assets/public/

# ==========================================
# Android Studio
# ==========================================

android/.idea/
android/*.iml
android/app/*.iml

# ==========================================
# Capacitor
# ==========================================

.capacitor/

# ==========================================
# VS Code
# ==========================================

.vscode/*
!.vscode/tasks.json

# ==========================================
# Coverage / testing
# ==========================================

coverage/
.nyc_output/

# ==========================================
# Operating System
# ==========================================

.DS_Store
Thumbs.db
desktop.ini

# Temporary editor files
*.swp
*.swo